table Calendario
	lineageTag: 994df36d-1125-4c77-8a98-757a19115989

	column Mes
		dataType: dateTime
		isNameInferred
		formatString: General Date
		lineageTag: d3726e2b-927a-4de2-946f-61448b42c8ed
		summarizeBy: none
		sourceColumn: [Mes]

		annotation SummarizationSetBy = Automatic

	column Año
		dataType: int64
		isNameInferred
		formatString: 0
		lineageTag: 690b16ea-f49c-42a6-bd77-9dce00a3995e
		summarizeBy: none
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column NumMes
		dataType: int64
		isNameInferred
		formatString: 0
		lineageTag: 43ddf198-70ca-46f8-ae5c-2ad545927641
		summarizeBy: none
		sourceColumn: [NumMes]

		annotation SummarizationSetBy = Automatic

	column MesEtiqueta
		dataType: string
		isNameInferred
		lineageTag: 82d63345-0001-43cf-b36a-f79521620001
		summarizeBy: none
		sourceColumn: [MesEtiqueta]
		sortByColumn: Mes

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				VAR Meses =
				    FILTER (
				        DISTINCT (
				            UNION (
				                SELECTCOLUMNS ( 'Base Real', "Mes", 'Base Real'[mes año] ),
				                SELECTCOLUMNS ( PA, "Mes", PA[mes año] )
				            )
				        ),
				        NOT ISBLANK ( [Mes] )
				    )
				RETURN
				    ADDCOLUMNS (
				        Meses,
				        "Año", YEAR ( [Mes] ),
				        "NumMes", MONTH ( [Mes] ),
				        "MesEtiqueta", FORMAT ( [Mes], "MMM yyyy" )
				    )

	annotation PBI_ResultType = Table
